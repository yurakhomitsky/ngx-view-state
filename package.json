{
  "name": "ngx-view-state",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --stats-json",
    "watch": "ng build --watch --configuration development",
    "build-lib": "ng build ngx-view-state",
    "build-lib-watch": "ng build ngx-view-state --watch",
    "test": "ng test",
    "test-lib": "ng test ngx-view-state --browsers=ChromeHeadless",
    "prepare": "husky",
    "lint": "ng lint --fix",
    "format": "prettier --write \"{src,projects}/**/*.{js,ts,json,css,scss,md,html}\""
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/schematics": "^20.2.1",
    "@angular/animations": "^20.2.3",
    "@angular/cdk": "^20.2.1",
    "@angular/common": "^20.2.3",
    "@angular/compiler": "^20.2.3",
    "@angular/core": "^20.2.3",
    "@angular/forms": "^20.2.3",
    "@angular/material": "^20.2.1",
    "@angular/platform-browser": "^20.2.3",
    "@angular/platform-browser-dynamic": "^20.2.3",
    "@angular/router": "^20.2.3",
    "@ngrx/effects": "^20.0.1",
    "@ngrx/operators": "^20.0.1",
    "@ngrx/store": "^20.0.1",
    "@ngrx/store-devtools": "^20.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.1",
    "@angular/cli": "^20.2.1",
    "@angular/compiler-cli": "^20.2.3",
    "@eslint/js": "^9.28.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.1.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.1.0",
    "ng-packagr": "^20.2.0",
    "prettier": "3.5.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.41.0"
  },
  "lint-staged": {
    "{src,projects}/**/*.{js,ts}": "eslint --fix",
    "{src,projects}/**/*": "prettier --write --ignore-unknown"
  }
}