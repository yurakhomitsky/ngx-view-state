{
  "name": "ngx-view-state",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --stats-json",
    "watch": "ng build --watch --configuration development",
    "build-lib": "ng build ngx-view-state",
    "build-lib-watch": "ng build ngx-view-state --watch",
    "test": "ng test",
    "test-lib": "ng test ngx-view-state",
    "test-lib-ui": "ng test ngx-view-state --ui",
    "prepare": "husky",
    "lint": "ng lint --fix",
    "format": "prettier --write \"{src,projects}/**/*.{js,ts,json,css,scss,md,html}\""
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/schematics": "^21.0.5",
    "@angular/animations": "^21.0.8",
    "@angular/cdk": "^21.0.6",
    "@angular/common": "^21.0.8",
    "@angular/compiler": "^21.0.8",
    "@angular/core": "^21.0.8",
    "@angular/forms": "^21.0.8",
    "@angular/material": "^21.0.6",
    "@angular/platform-browser": "^21.0.8",
    "@angular/platform-browser-dynamic": "^21.0.8",
    "@angular/router": "^21.0.8",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/operators": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@ngrx/store-devtools": "^21.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.8",
    "@eslint/js": "^9.28.0",
    "@vitest/ui": "^4.0.17",
    "angular-eslint": "20.1.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.1.0",
    "ng-packagr": "^21.0.1",
    "prettier": "3.5.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "^4.0.17"
  },
  "lint-staged": {
    "{src,projects}/**/*.{js,ts}": "eslint --fix",
    "{src,projects}/**/*": "prettier --write --ignore-unknown"
  }
}
